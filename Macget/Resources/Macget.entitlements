<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is OFF (we are NOT shipping to the Mac App Store).
         If you ever want MAS, you'll need to set this to true and add
         several other entitlements. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Hardened Runtime is required for notarization. -->
    <!-- The following exception lets Sparkle replace dynamic libraries
         when applying an update. Without this, updates fail. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Permits outgoing network connections. Sandbox-only key, but harmless. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
