{
  "name": "macget-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run sync-assets",
    "prebuild": "bun run sync-assets",
    "sync-assets": "cp ../Macget/Resources/Branding/macget-icon.svg public/macget-icon.svg && cp ../Macget/Resources/Branding/macget-wordmark.svg public/macget-wordmark.svg && cp ../Macget/Resources/Branding/macget-icon.svg app/icon.svg && cp ../CHANGELOG.md content/CHANGELOG.md",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fumadocs-core": "16.13.0",
    "fumadocs-ui": "16.13.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.7",
    "motion": "^12.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.2.12",
    "fumadocs-mdx": "15.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
