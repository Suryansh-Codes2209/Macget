{
  "name": "macget-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run sync-assets",
    "prebuild": "bun run sync-assets",
    "sync-assets": "cp ../Macget/Resources/Branding/macget-icon.svg public/macget-icon.svg && cp ../Macget/Resources/Branding/macget-wordmark.svg public/macget-wordmark.svg && cp ../Macget/Resources/Branding/macget-icon.svg app/icon.svg",
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "motion": "^12.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "postcss": "^8.4.49",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6"
  }
}
